 if(!questions.length){
  alert("Não existem perguntas suficientes para este modo.");
  return;
 }

 current=0;
 score=0;
 correctCount=0;
 wrongCount=0;
 streak=0;
 maxStreak=0;
 lives=3;
 xpEarned=0;
 fiftyUsed=false;
 skipUsed=false;
 selected=null;

 document.getElementById("menu").classList.add("hidden");
