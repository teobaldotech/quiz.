 getResultMessage(percent);

 document.getElementById("achievement").innerHTML=
 getAchievement(percent);

 saveHistory(percent);
 saveRanking(percent);
 loadRecords();
 loadHistory();
 loadRanking();
 renderDashboard();

 playSound("finish");
}

function getResultMessage(percent){

 if(percent===100)return"🌟 Perfeito! Você acertou tudo!";
 if(percent>=80)return"🔥 Excelente desempenho!";
 if(percent>=60)return"👏 Muito bom! Continue evoluindo.";
 if(percent>=40)return"💪 Bom começo! Continue treinando.";
 return"📚 Continue estudando e tente novamente.";
}

function getAchievement(percent){

 if(percent===100)
  return"👑 <strong>Conquista desbloqueada:</strong> Mestre do Quiz!";

 if(maxStreak>=5)
  return"🔥 <strong>Conquista desbloqueada:</strong> Combo Insano!";

 if(percent>=80)
  return"🥇 <strong>Conquista desbloqueada:</strong> Especialista!";

 if(correctCount>=5)
  return"🏅 <strong>Conquista desbloqueada:</strong> Conhecedor!";

