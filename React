function shuffle(array) {

    const arr = [...array];

    for (let i = arr.length - 1; i > 0; i--) {

        const j = Math.floor(Math.random() * (i + 1));

        [arr[i], arr[j]] = [arr[j], arr[i]];

    }

    return arr;
}


function getAllQuestions() {

    return Object.values(quizData).flat();

}


function getQuestions(sub) {

    let all = sub === "geral"
        ? getAllQuestions()
        : quizData[sub];

    const key = "used_" + sub;

    let used = JSON.parse(
        localStorage.getItem(key) || "[]"
    );

    let unused = all.filter(
        question => !used.includes(question.id)
    );

    if (unused.length === 0) {

        localStorage.removeItem(key);

        unused = all;

    }

    return shuffle(unused);

}


/* =====================================================
   INICIAR QUIZ
===================================================== */

function startQuiz(sub) {

    subject = sub;

    questions = getQuestions(sub);

    current = 0;

    score = 0;
    correctCount = 0;
    wrongCount = 0;

    streak = 0;
    maxStreak = 0;

    selected = null;

    document.getElementById("menu")
        .classList.add("hidden");

    document.getElementById("result")
        .classList.add("hidden");

    document.getElementById("quiz")
        .classList.remove("hidden");

    document.getElementById("subjectBadge")
        .textContent = getSubjectName(sub);

    showQuestion();

}


/* =====================================================
   MOSTRAR QUESTÃO
===================================================== */

function showQuestion() {

    clearInterval(timerInterval);

    selected = null;

    timeLeft = TIME_LIMIT;

    const question = questions[current];

    document.getElementById("questionText")
        .textContent = question.pergunta;

    document.getElementById("questionNumber")
        .textContent =
        `Questão ${current + 1} de ${questions.length}`;

    const progress =
        ((current + 1) / questions.length) * 100;

    document.getElementById("progressBar")
        .style.width = progress + "%";

    document.getElementById("progressPercent")
        .textContent = Math.round(progress) + "%";

    document.getElementById("score")
        .textContent = score;

    document.getElementById("streak")
        .textContent = streak + " 🔥";

    document.getElementById("correctCount")
        .textContent = correctCount;

    const options =
        document.getElementById("options");

    options.innerHTML = "";

    document.getElementById("feedback")
        .innerHTML = "";

    document.getElementById("nextButton")
        .classList.add("hidden");

    question.alternativas.forEach(
        (alternative, index) => {

            const button =
                document.createElement("button");

            button.className = "option";

            button.textContent =
                `${String.fromCharCode(65 + index)}) ${alternative}`;

            button.onclick =
                () => handleAnswer(index);

            options.appendChild(button);

        }
    );

    updateTimer();

    timerInterval = setInterval(() => {

        timeLeft--;

        updateTimer();

        if (timeLeft <= 0) {

            clearInterval(timerInterval);

            handleAnswer(-1);

        }

    }, 1000);

}


/* =====================================================
   TIMER
===================================================== */

function updateTimer() {

    const timer =
        document.getElementById("timer");

    timer.textContent =
        `⏱️ ${timeLeft}s`;

    timer.classList.toggle(
        "warning",
        timeLeft <= 5
    );

}


/* =====================================================
   RESPONDER
===================================================== */

function handleAnswer(index) {

    if (selected !== null) return;

    selected = index;

    clearInterval(timerInterval);

    const question = questions[current];

    const buttons =
        document.querySelectorAll(".option");

    buttons.forEach(
        button => button.disabled = true
    );

    buttons[question.correta]
        .classList.add("correct");

    const correct =
        index === question.correta;

    const feedback =
        document.getElementById("feedback");

    if (correct) {

        correctCount++;

        streak++;

        if (streak > maxStreak) {
            maxStreak = streak;
        }

        /*
         Bônus:
         base = 100
         velocidade = até +50
         sequência = até +100
        */

        const speedBonus =
            Math.max(0, timeLeft * 3);

        const streakBonus =
            Math.min(streak * 10, 100);

        const points =
            100 + speedBonus + streakBonus;

        score += points;

        feedback.className =
            "feedback success";

        feedback.innerHTML =
            `✅ <strong>Resposta correta!</strong><br>
             +${points} pontos`;

        buttons[index]
            .classList.add("correct");

    } else {

        wrongCount++;

        streak = 0;

        if (index >= 0) {

            buttons[index]
                .classList.add("wrong");

        }

        feedback.className =
            "feedback error";

        feedback.innerHTML =
            index === -1
                ? `⏰ <strong>Tempo esgotado!</strong><br>
                   A resposta correta era:
                   <strong>${question.alternativas[question.correta]}</strong>`
                : `❌ <strong>Resposta incorreta.</strong><br>
                   A resposta correta era:
                   <strong>${question.alternativas[question.correta]}</strong>`;

    }

    saveUsedQuestion(question.id);

    document.getElementById("score")
        .textContent = score;

    document.getElementById("streak")
        .textContent = streak + " 🔥";

    document.getElementById("correctCount")
        .textContent = correctCount;

    document.getElementById("nextButton")
        .classList.remove("hidden");

}


/* =====================================================
   SALVAR QUESTÃO USADA
===================================================== */

function saveUsedQuestion(id) {

    const key = "used_" + subject;

    let used =
        JSON.parse(
            localStorage.getItem(key) || "[]"
        );

    if (!used.includes(id)) {

        used.push(id);

        localStorage.setItem(
            key,
            JSON.stringify(used)
        );

    }

}


/* =====================================================
   PRÓXIMA
===================================================== */

function nextQuestion() {

    current++;

    if (current >= questions.length) {

        finishQuiz();

        return;

    }

    showQuestion();

}


/* =====================================================
   FINALIZAR
===================================================== */

function finishQuiz() {

    clearInterval(timerInterval);

    document.getElementById("quiz")
        .classList.add("hidden");

    document.getElementById("result")
        .classList.remove("hidden");

    const percent =
        Math.round(
            (correctCount / questions.length) * 100
        );

    const previousRecord =
        Number(
            localStorage.getItem(
                "rank_" + subject
            )
        ) || 0;

    const newRecord =
        percent > previousRecord;

    if (newRecord) {

        localStorage.setItem(
            "rank_" + subject,
            percent
        );

    }

    document.getElementById("resultSubject")
        .textContent =
        getSubjectName(subject);

    document.getElementById("finalPercent")
        .textContent = percent + "%";

    document.getElementById("finalScore")
        .textContent = score;

    document.getElementById("finalCorrect")
        .textContent = correctCount;

    document.getElementById("finalWrong")
        .textContent = wrongCount;

    document.getElementById("finalStreak")
        .textContent = maxStreak;

    document.getElementById("finalMessage")
        .textContent =
        getResultMessage(percent);

    document.getElementById("recordMessage")
        .innerHTML =
        newRecord
            ? "🏆 <strong>Novo recorde!</strong>"
            : `🏅 Seu recorde: ${Math.max(previousRecord, percent)}%`;

    saveHistory(percent);

    loadRecords();

    loadHistory();

}


/* =====================================================
   MENSAGEM
===================================================== */

function getResultMessage(percent) {

    if (percent === 100)
        return "🌟 Perfeito! Você acertou tudo!";

    if (percent >= 80)
        return "🔥 Excelente desempenho!";

    if (percent >= 60)
        return "👏 Muito bom! Continue treinando.";

    if (percent >= 40)
        return "💪 Bom começo! Você pode melhorar.";

    return "📚 Continue estudando e tente novamente.";

}


/* =====================================================
   NOMES
===================================================== */

function getSubjectName(sub) {

    const names = {

        geral: "🌐 Quiz Geral",

        geografia: "🌎 Geografia",

        portugues: "📝 Português",

        matematica: "🔢 Matemática",

        historia: "📜 História",

        ciencias: "🔬 Ciências",

        ingles: "🇬🇧 Inglês",

        informatica: "💻 Informática",

        educacao: "⚽ Educação Física"

    };

    return names[sub] || sub;

}


/* =====================================================
   HISTÓRICO
===================================================== */

function saveHistory(percent) {

    let history =
        JSON.parse(
            localStorage.getItem("quiz_history") || "[]"
        );

    history.unshift({

        subject: getSubjectName(subject),

        percent,

        score,

        date:
            new Date().toLocaleString("pt-BR")

    });

    history =
        history.slice(0, 8);

    localStorage.setItem(
        "quiz_history",
        JSON.stringify(history)
    );

}


function loadHistory() {

    const container =
        document.getElementById("historyList");

    let history =
        JSON.parse(
            localStorage.getItem("quiz_history") || "[]"
        );

    if (!history.length) {

        container.innerHTML =
            `<div class="empty">
                Nenhuma partida registrada.
            </div>`;

        return;

    }

    container.innerHTML =
        history.map(item => `

            <div class="history-item">

                <span>
                    ${item.subject}<br>
                    <small>${item.date}</small>
                </span>

                <strong>
                    ${item.percent}%<br>
                    ${item.score} pts
                </strong>

            </div>

        `).join("");

}


/* =====================================================
   RECORDES
===================================================== */

function loadRecords() {

    const subjects = [

        "geral",
        "geografia",
        "portugues",
        "matematica",
        "historia",
        "ciencias",
        "ingles",
        "informatica",
        "educacao"

    ];

    subjects.forEach(sub => {

        const element =
            document.getElementById(
                "record-" + sub
            );

        if (!element) return;

        const record =
            Number(
                localStorage.getItem(
                    "rank_" + sub
                )
            ) || 0;

        element.textContent =
            `Recorde: ${record}%`;

    });

}


/* =====================================================
   REINICIAR
===================================================== */

function restartSame() {

    startQuiz(subject);

}


function backToMenu() {

    clearInterval(timerInterval);

    document.getElementById("quiz")
        .classList.add("hidden");

    document.getElementById("result")
        .classList.add("hidden");

    document.getElementById("menu")
        .classList.remove("hidden");

    subject = "";

    questions = [];

    loadRecords();

    loadHistory();

}


/* =====================================================
   TEMA
===================================================== */

function toggleTheme() {

    document.body.classList.toggle("dark");

    const dark =
        document.body.classList.contains("dark");

    localStorage.setItem(
        "quiz_theme",
        dark ? "dark" : "light"
    );

    document.getElementById("themeBtn")
        .textContent =
        dark ? "☀️" : "🌙";

}


function loadTheme() {

    const theme =
        localStorage.getItem("quiz_theme");

    if (theme === "dark") {

        document.body.classList.add("dark");

        document.getElementById("themeBtn")
            .textContent = "☀️";

    }

}


/* =====================================================
   SOM
===================================================== */

function playSound(type) {

    try {

        const AudioContext =
            window.AudioContext ||
            window.webkitAudioContext;

        const ctx =
            new AudioContext();

        const oscillator =
            ctx.createOscillator();

        const gain =
            ctx.createGain();

        oscillator.connect(gain);

        gain.connect(ctx.destination);

        oscillator.frequency.value =
            type === "correct"
                ? 700
                : 180;

        oscillator.type = "sine";

        gain.gain.setValueAtTime(
            0.08,
            ctx.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
            0.001,
            ctx.currentTime + .25
        );

        oscillator.start();

        oscillator.stop(
            ctx.currentTime + .25
        );

    } catch (error) {

        console.log("Áudio indisponível.");

    }

}


/* =====================================================
   PATCH DO SOM
===================================================== */

const originalHandleAnswer =
    handleAnswer;

handleAnswer = function(index) {

    const question =
        questions[current];

    if (selected !== null) return;

    playSound(
        index === question.correta
            ? "correct"
            : "wrong"
    );

    originalHandleAnswer(index);

};


/* =====================================================
   INICIALIZAÇÃO
===================================================== */

loadTheme();

loadRecords();

loadHistory();

</script>

