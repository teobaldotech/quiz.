  Number(localStorage.getItem("rank_"+subject))||0;

 const newRecord=percent>previous;

 if(newRecord)
  localStorage.setItem("rank_"+subject,percent);

 document.getElementById("resultSubject").textContent=
 getSubjectName(subject);

 document.getElementById("finalPercent").textContent=
 percent+"%";

 document.getElementById("finalScore").textContent=score;
 document.getElementById("finalCorrect").textContent=correctCount;
