    justify-content: flex-end;
    margin-bottom: 15px;
}

.theme-btn {
    border: 1px solid var(--border);
    background: var(--option);
    color: var(--text);
    padding: 9px 13px;
    border-radius: 12px;
    cursor: pointer;
    font-size: 18px;
}

.section-title {
    margin-bottom: 17px;
}

.subject-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 12px;
}

.subject-btn {
    border: 1px solid var(--border);
    background: var(--option);
    color: var(--text);
    border-radius: 15px;
    padding: 17px;
    cursor: pointer;
    text-align: left;
    font-size: 16px;
    transition: .2s;
}

.subject-btn:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    background: rgba(37,99,235,.08);
}

.subject-icon {
    font-size: 27px;
    display: block;
    margin-bottom: 6px;
}

.subject-name {
    font-weight: bold;
}

.subject-record {
    color: var(--muted);
    font-size: 12px;
    margin-top: 5px;
}

.quiz-header {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    align-items: center;
    margin-bottom: 17px;
    flex-wrap: wrap;
}

.badge {
    background: rgba(37,99,235,.12);
    color: var(--primary);
    padding: 8px 12px;
    border-radius: 999px;
    font-size: 13px;
    font-weight: bold;
}

.timer {
    font-size: 21px;
    font-weight: bold;
    color: var(--danger);
}

.timer.warning {
    animation: pulse .7s infinite;
}

@keyframes pulse {
    50% {
        transform: scale(1.08);
    }
}

.progress-info {
    display: flex;
    justify-content: space-between;
    color: var(--muted);
    font-size: 13px;
    margin-bottom: 7px;
}

.progress {
    height: 10px;
    background: var(--border);
    border-radius: 99px;
    overflow: hidden;
    margin-bottom: 25px;
}

.progress-bar {
    height: 100%;
    background: linear-gradient(90deg, #2563eb, #7c3aed);
