  k==="quiz_history"||
  k==="quiz_ranking"||
  k==="quiz_xp"
 )
 .forEach(k=>localStorage.removeItem(k));

 loadRecords();
 loadHistory();
 loadRanking();
 renderDashboard();
 updateLevel();
}


