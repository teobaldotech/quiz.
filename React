    font-family: Arial, Helvetica, sans-serif;
    color: var(--text);
    transition: .3s;
}

button {
    font-family: inherit;
}

.app {
    width: min(900px, 94%);
    margin: auto;
    padding: 25px 0 40px;
}

.header {
    text-align: center;
    margin-bottom: 20px;
}

.logo {
    font-size: 45px;
    margin-bottom: 8px;
}

.header h1 {
    font-size: clamp(26px, 5vw, 40px);
    margin-bottom: 7px;
}

.header p {
    color: var(--muted);
}

.card {
    background: var(--card);
    border: 1px solid var(--border);
