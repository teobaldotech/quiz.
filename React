/* ==========================================================
 UTILITÁRIOS
========================================================== */

function allQuestions(){
 return Object.values(quizData).flat();
}

function shuffle(arr){
 const a=[...arr];

 for(let i=a.length-1;i>0;i--){
  const j=Math.floor(Math.random()*(i+1));
  [a[i],a[j]]=[a[j],a[i]];
 }

 return a;
}

function getQuestions(sub){

 let pool=sub==="geral"?allQuestions():quizData[sub];

 const used=JSON.parse(
  localStorage.getItem("used_"+sub)||"[]"
 );

 let filtered=pool.filter(q=>q.d===difficulty);

 if(filtered.length<3)
  filtered=pool;

 let unused=filtered.filter(
  q=>!used.includes(q.id)
 );

 if(!unused.length){
  localStorage.removeItem("used_"+sub);
  unused=filtered;
 }

 let result=shuffle(unused);

 if(gameMode==="relampago")
  result=result.slice(0,Math.min(10,result.length));

 else if(gameMode==="desafio")
  result=result.filter(q=>q.d!=="facil");

 if(!result.length)
  result=shuffle(unused);

 return result;
}

function getSubjectName(s){

 const names={
 geral:"🌐 Quiz Geral",
 geografia:"🌎 Geografia",
 portugues:"📝 Português",
 matematica:"🔢 Matemática",
 historia:"📜 História",
 ciencias:"🔬 Ciências",
 ingles:"🇬🇧 Inglês",
 informatica:"💻 Informática",
 educacao:"⚽ Educação Física"
 };

 return names[s]||s;
}


