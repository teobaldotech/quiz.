}

.option:disabled {
    cursor: default;
}

.option.correct {
    background: rgba(22,163,74,.15);
    border-color: var(--success);
    color: var(--success);
    font-weight: bold;
}

.option.wrong {
    background: rgba(220,38,38,.15);
    border-color: var(--danger);
    color: var(--danger);
    font-weight: bold;
}

.feedback {
    margin-top: 17px;
    padding: 13px;
    border-radius: 12px;
    background: var(--option);
    border: 1px solid var(--border);
    line-height: 1.5;
}

.feedback.success {
    border-color: var(--success);
}

.feedback.error {
    border-color: var(--danger);
}

.next-btn,
.primary-btn {
    width: 100%;
    border: none;
    background: linear-gradient(135deg, var(--primary), #7c3aed);
    color: white;
    padding: 15px;
    border-radius: 13px;
    margin-top: 15px;
    cursor: pointer;
    font-size: 16px;
    font-weight: bold;
}

.next-btn:hover,
.primary-btn:hover {
    filter: brightness(1.08);
}

.menu-btn {
    width: 100%;
    border: 1px solid var(--border);
    background: var(--option);
    color: var(--text);
    padding: 14px;
    border-radius: 13px;
    margin-top: 10px;
    cursor: pointer;
}

.result {
    text-align: center;
}

.result-icon {
    font-size: 65px;
    margin-bottom: 10px;
