/* ==========================================================
 QUESTÃO
========================================================== */

function showQuestion(){

 clearInterval(timerInterval);

 selected=null;

 const q=questions[current];

 timeLeft=timeMode;

 document.getElementById("questionText").textContent=q.p;

 document.getElementById("questionNumber").textContent=
 `Questão ${current+1} de ${questions.length}`;

 const progress=((current+1)/questions.length)*100;

 document.getElementById("progressBar").style.width=
 progress+"%";

 document.getElementById("progressPercent").textContent=
 Math.round(progress)+"%";

 document.getElementById("score").textContent=score;

 document.getElementById("streak").textContent=
 streak+" 🔥";

 document.getElementById("correctCount").textContent=
 correctCount;

 updateLives();

 document.getElementById("feedback").innerHTML="";

 document.getElementById("nextButton").classList.add("hidden");

 const options=document.getElementById("options");

 options.innerHTML="";

 shuffle(q.a.map((text,index)=>({
  text,
  index
 }))).forEach(item=>{

  const btn=document.createElement("button");

  btn.className="option";

  btn.textContent=
   `${String.fromCharCode(65+options.children.length)}) ${item.text}`;

  btn.dataset.original=item.index;

  btn.onclick=()=>handleAnswer(item.index);

  options.appendChild(btn);

 });

 document.getElementById("fiftyBtn").disabled=fiftyUsed;
 document.getElementById("skipBtn").disabled=skipUsed;

 updateTimer();

 if(timeMode>0){

  timerInterval=setInterval(()=>{

   timeLeft--;

   updateTimer();

   if(timeLeft<=0){

    clearInterval(timerInterval);

    handleAnswer(-1);

   }

  },1000);

 }

}

function updateTimer(){

 const timer=document.getElementById("timer");

 timer.textContent=
 timeMode===0
 ?"⏱️ ∞"
 :`⏱️ ${timeLeft}s`;

 timer.classList.toggle(
 "warning",
 timeMode>0&&timeLeft<=5
 );

}

function updateLives(){

 document.getElementById("lives").textContent=
 "❤️".repeat(Math.max(0,lives))+
 "🖤".repeat(3-Math.max(0,lives));
}


/* ==========================================================
 RESPOSTA
========================================================== */

function handleAnswer(index){

 if(selected!==null)return;

 selected=index;

 clearInterval(timerInterval);

 const q=questions[current];

 const buttons=document.querySelectorAll(".option");

 buttons.forEach(btn=>btn.disabled=true);

 buttons.forEach(btn=>{

  if(Number(btn.dataset.original)===q.c)
   btn.classList.add("correct");

 });

 const correct=index===q.c;

 const feedback=document.getElementById("feedback");

 if(correct){

  correctCount++;
  streak++;

  maxStreak=Math.max(maxStreak,streak);

  let base=
   difficulty==="dificil"?180:
   difficulty==="medio"?140:100;

  let speed=
   timeMode>0?Math.max(0,timeLeft*4):0;

  let combo=
   Math.min(streak*15,120);

  let points=base+speed+combo;

  if(gameMode==="relampago")
   points+=50;

  score+=points;

  const gainedXP=
   difficulty==="dificil"?25:
   difficulty==="medio"?18:12;

  addXP(gainedXP);

  feedback.className="feedback success";

  feedback.innerHTML=
  `✅ <strong>Resposta correta!</strong><br>
   +${points} pontos • +${gainedXP} XP`;

  const chosen=Array.from(buttons).find(
   b=>Number(b.dataset.original)===index
  );

  if(chosen)chosen.classList.add("correct");

  playSound("correct");

 }else{

  wrongCount++;
  streak=0;
  lives--;

  if(index>=0){

   const chosen=Array.from(buttons).find(
    b=>Number(b.dataset.original)===index
   );

   if(chosen)chosen.classList.add("wrong");

  }

  feedback.className="feedback error";

  feedback.innerHTML=
   index===-1
   ?`⏰ <strong>Tempo esgotado!</strong><br>
     Resposta correta:
     <strong>${q.a[q.c]}</strong>`
   :`❌ <strong>Resposta incorreta.</strong><br>
     Resposta correta:
     <strong>${q.a[q.c]}</strong>`;

  playSound("wrong");

  updateLives();

 }

 saveUsedQuestion(q.id);

 document.getElementById("score").textContent=score;
 document.getElementById("streak").textContent=streak+" 🔥";
 document.getElementById("correctCount").textContent=correctCount;

 document.getElementById("nextButton").classList.remove("hidden");

 if(lives<=0){

  document.getElementById("nextButton").textContent=
   "🏁 Finalizar partida";

 }

}

function saveUsedQuestion(id){

 const key="used_"+subject;

 let used=JSON.parse(
  localStorage.getItem(key)||"[]"
 );

 if(!used.includes(id))
  used.push(id);

 localStorage.setItem(key,JSON.stringify(used));
}


